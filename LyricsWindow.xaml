<Window x:Class="SpotifyTaskbarWidget.LyricsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Spotify Taskbar Lyrics"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        Height="40"
        Width="300">
    <Grid x:Name="Root" Background="#01000000" ClipToBounds="True" MouseLeftButtonDown="Root_MouseLeftButtonDown">
        <!-- Layer 1 -->
        <TextBlock x:Name="LyricText"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Stretch"
                   FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif"
                   FontSize="12"
                   FontWeight="SemiBold"
                   Foreground="#F5F5F5"
                   TextTrimming="CharacterEllipsis"
                   TextWrapping="Wrap"
                   TextAlignment="Center"
                   Margin="4,0,4,0"
                   Opacity="1">
            <TextBlock.RenderTransform>
                <TranslateTransform x:Name="LyricTransform" X="0" Y="0"/>
            </TextBlock.RenderTransform>
            <TextBlock.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="5" ShadowDepth="1" Opacity="0.85" Direction="270"/>
            </TextBlock.Effect>
        </TextBlock>

        <!-- Layer 2 -->
        <TextBlock x:Name="LyricTextTop"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Stretch"
                   FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif"
                   FontSize="12"
                   FontWeight="SemiBold"
                   Foreground="#F5F5F5"
                   TextTrimming="CharacterEllipsis"
                   TextWrapping="Wrap"
                   TextAlignment="Center"
                   Margin="4,0,4,0"
                   Opacity="0">
            <TextBlock.RenderTransform>
                <TranslateTransform x:Name="LyricTransformTop" X="0" Y="0"/>
            </TextBlock.RenderTransform>
            <TextBlock.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="5" ShadowDepth="1" Opacity="0.85" Direction="270"/>
            </TextBlock.Effect>
        </TextBlock>
    </Grid>
</Window>
